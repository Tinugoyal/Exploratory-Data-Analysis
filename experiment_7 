        "\n",
        "try:\n",
        "    print(\"--- DATASET STREAMED SUCCESSFULLY FROM URL ---\")\n",
        "    print(df.head())\n",
        "    print(\"\\n\" + \"=\"*50 + \"\\n\")\n",
        "except Exception as e:\n",
        "    print(f\"Network error trying to download file from URL link: {e}\")\n",
        "    print(\"Please check your internet connection.\")\n",
        "    exit()\n",
        "\n",
        "def plot_pie(data, labels, title=\"Pie Chart\"):\n",
        "\n",
        "    plt.figure()\n",
        "    plt.pie(data, labels=labels, autopct='%1.1f%%', startangle=140, colors=sns.color_palette(\"pastel\"))\n",
        "    plt.title(title, fontsize=13, weight='bold')\n",
        "    plt.show()\n",
        "\n",
        "def plot_bar(categories, values, title=\"Bar Chart\"):\n",
        "\n",
        "    plt.figure()\n",
        "    sns.barplot(x=categories, y=values, hue=categories, palette=\"muted\", legend=False)\n",
        "    plt.title(title, fontsize=13, weight='bold')\n",
        "    plt.xlabel(\"Category Names\")\n",
        "    plt.ylabel(\"Data Metrics\")\n",
        "    plt.show()\n",
        "\n",
        "def plot_histogram(data_frame, column):\n",
        "    plt.figure()\n",
        "    sns.histplot(data=data_frame, x=column, kde=True, color=\"purple\", bins=15)\n",
        "    plt.title(f\"Histogram Data Spread: {column}\", fontsize=13, weight='bold')\n",
        "    plt.show()\n",
        "\n",
        "def heatmap(data_frame, annot=True, cmap='coolwarm'):\n",
        "    \"\"\"Draws a grid mapping colors directly to raw row values.\"\"\"\n",
        "    plt.figure()\n",
        "\n",
        "    numeric_grid = data_frame.select_dtypes(include=[np.number]).iloc[:15, :]\n",
        "    sns.heatmap(numeric_grid, annot=annot, cmap=cmap)\n",
        "    plt.title(\"Grid Heatmap Matrix View (First 15 Rows)\", fontsize=13, weight='bold')\n",
        "    plt.show()\n",
        "\n",
        "def scatter(x_data, y_data, title=\"Scatter Plot\"):\n",
        "\n",
        "    plt.figure()\n",
        "    sns.scatterplot(x=x_data, y=y_data, s=100, color='darkorange', edgecolor='black')\n",
        "    plt.title(title, fontsize=13, weight='bold')\n",
        "    plt.show()\n",
        "\n",
        "def correlation_heatmap(data_frame, annot=True, cmap='coolwarm'):\n",
        "\n",
        "    plt.figure()\n",
        "    corr_matrix = data_frame.corr(numeric_only=True)\n",
        "    sns.heatmap(corr_matrix, annot=annot, cmap=cmap, vmin=-1, vmax=1, fmt=\".2f\")\n",
        "    plt.title(\"Correlation Strength Mapping\", fontsize=13, weight='bold')\n",
        "    plt.show()\n",
        "\n",
        "def plot_dendrogram(data_frame):\n",
        "\n",
        "    plt.figure()\n",
        "    numeric_data = data_frame.select_dtypes(include=[np.number])\n",
        "\n",
        "    linked_matrix = linkage(numeric_data, method='ward')\n",
        "    dendrogram(linked_matrix, truncate_mode='lastp', p=20, leaf_rotation=90.)\n",
        "    plt.title(\"Hierarchical Data Relationship Tree (Dendrogram)\", fontsize=13, weight='bold')\n",
        "    plt.ylabel(\"Distance Closeness\")\n",
        "    plt.show()\n",
        "\n",
        "def plot_wordcloud(data_frame):\n",
        "\n",
        "    text_paragraph = \" \".join(data_frame['species'].astype(str).tolist())\n",
        "    w_cloud = WordCloud(width=600, height=300, background_color='white', colormap='magma').generate(text_paragraph)\n",
        "\n",
        "    plt.figure()\n",
        "    plt.imshow(w_cloud, interpolation='bilinear')\n",
        "    plt.axis('off')\n",
        "    plt.title(\"Word Frequency Visualization Layout\", fontsize=13, weight='bold')\n",
        "    plt.show()\n",
        "\n",
        "def plot_choropleth():\n",
        "    global_distribution = pd.DataFrame({\n",
        "        'ISO_Alpha': ['USA', 'IND', 'DEU', 'BRA', 'CAN'],\n",
        "        'Metric_Value': [45, 89, 23, 56, 72]\n",
        "    })\n",
        "    fig = px.choropleth(global_distribution, locations=\"ISO_Alpha\", color=\"Metric_Value\",\n",
        "                        hover_name=\"ISO_Alpha\", title=\"Interactive Geographic Value Map\")\n",
        "    fig.show()\n",
        "\n",
        "\n"
      ],
